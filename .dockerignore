# Everything here is excluded from the build context. Keeping it small makes builds
# faster and stops host-only files (like .env) from ending up in the image.

node_modules
dist
.git
.gitignore

# Secrets never belong in an image — config comes from the environment.
.env
.env.*

# Not needed at runtime.
scripts
db
docker-compose.yml
Dockerfile
.dockerignore
*.md
