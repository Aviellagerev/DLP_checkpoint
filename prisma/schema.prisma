// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum DataTypeEnum {
  keywords
}

model DataType {
  id          String       @id @default(uuid())
  name        String
  description String
  type        DataTypeEnum @default(keywords)
  content     String[]
  threshold   Int
  dataSets    DataSet[]    @relation("DataSetToDataType")
}

model DataSet {
  id        String     @id @default(uuid())
  name      String
  dataTypes DataType[] @relation("DataSetToDataType")
}
